{
  "name": "lwclipper",
  "version": "5.2.1",
  "description": "Lightweight clipper for local files and video links",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "splash": "electron scripts/make-splash.js",
    "dist": "electron-builder && node scripts/build-launcher.js",
    "launcher": "node scripts/build-launcher.js"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.ceeser.lwclipper",
    "productName": "LWClipper",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "images/**/*"
    ],
    "extraResources": [
      {
        "from": "tools",
        "to": "tools"
      },
      {
        "from": "locales",
        "to": "locales",
        "filter": [
          "*.json"
        ]
      },
      {
        "from": "icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico",
      "fileAssociations": [
        {
          "ext": "lwc",
          "name": "LWClipper.Project",
          "description": "LWClipper Project",
          "icon": "icon.ico"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "LWClipper v${version} Setup.${ext}",
      "include": "scripts/installer.nsh",
      "differentialPackage": false
    },
    "publish": null
  },
  "author": "Ceeser"
}
